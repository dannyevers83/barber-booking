# ─── Local Docker database ──────────────────────────────────────────

# Choose your own password. Keep the real .env file out of Git.
POSTGRES_PASSWORD=replace_with_your_own_password

# ─── Optional backend configuration ─────────────────────────────────

# Set DATABASE_URL as a secret in Render for the hosted Neon database.
# Leave it unset locally to use Docker. Never commit real credentials.
# DATABASE_URL=postgresql://user:password@host:5432/database
# AUTO_MIGRATE=true

# Frontend authentication uses frontend/.env.local; see frontend/.env.example.
